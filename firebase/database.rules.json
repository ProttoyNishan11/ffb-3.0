            ".write": "auth != null && auth.uid === $participantUid && auth.token.firebase.sign_in_provider === 'anonymous' && root.child('rooms').child($roomId).child('meta').child('status').val() === 'active'",
            ".validate": "newData.hasChildren(['joinedAt']) && newData.numChildren() === 1 && newData.child('joinedAt').isNumber()"
          }
        }
      }
    }
  }
}\n